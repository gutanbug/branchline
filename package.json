{
  "name": "branchline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm build && pnpm test && pnpm test:native && pnpm test:git && node scripts/check-desktop.mjs && node scripts/check-ux-recovery.mjs && pnpm build-storybook",
    "test:native": "node scripts/check-native.mjs",
    "desktop": "pnpm build && electron .",
    "test:git": "node --test electron/file-actions.test.cjs electron/working-files.test.cjs electron/conflicts.test.cjs electron/git.test.cjs electron/agents.test.cjs electron/sync.test.cjs electron/hosting.test.cjs electron/reviews.test.cjs electron/mcp.test.cjs",
    "test:desktop": "pnpm build && node scripts/check-desktop.mjs && node scripts/check-ux-recovery.mjs",
    "package:desktop": "pnpm build && node scripts/package-desktop.mjs",
    "mcp": "node electron/mcp.cjs",
    "package:mac": "pnpm build && node scripts/package-desktop.mjs --mac",
    "package:win": "pnpm build && node scripts/package-desktop.mjs --win"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "storybook": "10.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "main": "electron/main.cjs",
  "description": "Branchline local Git workspace",
  "author": "Branchline"
}
